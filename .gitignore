# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
# Root-anchored AND nested: a stray `next build` run from inside a
# subdirectory writes its own .next/, and `/.next/` does not match those. Two
# such traces were committed under public/logos/.next/ and were served publicly
# at /logos/.next/trace until 6 Sep 2026.
/.next/
**/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which documents what the deployment needs and carries
# no secrets. Without it the ring builder's bucket URL is undiscoverable except
# by reading lib/ring/renders.ts.
!.env.example
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent / assistant notes (local only)

# graphify (local codebase analysis output)
graphify-out/

# generated product catalogue (built from data/products.csv)
/data/products.generated.ts
/lib/generated/

# video masters — the site serves the transcoded mp4, not these
/public/*.mov

# personal reference, not part of the project
PLAYBOOK-*.md

# Generated by scripts/build-watch-list-xlsx.py — rebuild it, do not track it.
alpoe-watch-list.xlsx

# Blender writes a .blend1 backup of the previous save beside every .blend.
# It is not a source file; two were committed (12.6MB) before 6 Sep 2026.
*.blend1
