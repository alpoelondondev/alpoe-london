# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which documents what the deployment needs and carries
# no secrets. Without it the ring builder's bucket URL is undiscoverable except
# by reading lib/ring/renders.ts.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent / assistant notes (local only)

# graphify (local codebase analysis output)
graphify-out/

# generated product catalogue (built from data/products.csv)
/data/products.generated.ts
/lib/generated/

# video masters — the site serves the transcoded mp4, not these
/public/*.mov

# personal reference, not part of the project
PLAYBOOK-*.md
